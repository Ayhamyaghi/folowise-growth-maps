# Database
DB_URL=jdbc:postgresql://localhost:5432/folowise_dev
DB_USERNAME=folowise
DB_PASSWORD=folowise

# JWT
# Generate a secure Base64-encoded secret of at least 32 bytes (256 bits) for production.
# Example (Linux/macOS): openssl rand -base64 32
JWT_SECRET=replace-with-a-secure-base64-encoded-secret
# 86400000 ms = 24 hours
JWT_EXPIRATION_MS=86400000
